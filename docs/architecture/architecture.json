  "cards": [
    {
      "dot": "violet",
      "title": "Dependency rule",
      "items": [
        "Every import points into the core.",
        "Adapters depend on ports; the core never imports an adapter.",
        "The core uses no packages; test/architecture.test.ts checks every import."
      ]
    },
    {
      "dot": "cyan",
      "title": "in and out",
      "items": [
        "in (driving): someone calls us, here HTTP.",
        "out (driven): we call someone, here Typst and the clock.",
        "The core owns both kinds of port."
      ]
    },
    {
      "dot": "amber",
      "title": "Composition root",
      "items": [
        "main.ts creates the adapters and the core and connects them.",
        "It is the only file that knows every part."
      ]
    },
    {
      "dot": "emerald",
      "title": "Errors are values",
      "items": [
        "The service returns { ok: false, error } for expected failures.",
        "The HTTP adapter maps each error kind to a status code."
      ]
    }
  ]
}
